ANTHROPIC_API_KEY=sk-ant-...
MODEL_FAST=claude-haiku-4-5-20251001        # used for planning, sub-researchers, verifier, interrogator
MODEL_SYNTHESIS=claude-sonnet-4-6           # used for synthesis (Step C) and architect
ARCH_MODE=lite                              # "lite" = single architect pass | "full" = v1 + critic + v2
DEPTH=standard                             # quick | standard | deep  (default for web server)
RESEARCH_CONCURRENCY=4                      # max parallel sub-researcher tasks
RESEARCH_SEARCHES_PER_SUBQ=3               # web_search budget per sub-question
RESEARCH_FETCHES_PER_SUBQ=2                # web_fetch budget per sub-question
RESEARCH_TIMEOUT_SECONDS=150               # hard time budget for parallel research phase
VERIFIER_ALLOW_SEARCH=false                # set true to allow 2 targeted searches in verifier
VERIFIER_BATCH_SIZE=12                     # claims per concurrent verification batch
